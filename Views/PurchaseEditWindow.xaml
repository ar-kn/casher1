<Window x:Class="PhoneAccounting.App.Views.PurchaseEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="تعديل فاتورة شراء"
        Width="900" Height="680"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="تعديل فاتورة الشراء" FontFamily="{StaticResource AppFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding InvoiceNumber}" FontFamily="{StaticResource AppFont}"
                                   FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding DateText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="10,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="إغلاق" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- ===== المحتوى ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,0">

            <Border Style="{StaticResource Card}" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="المورد / الشركة" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SupplierName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="إضافة منتج (اختياري)" FontFamily="{StaticResource AppFont}"
                               FontSize="14" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBox Style="{StaticResource ModernTextBox}" Margin="0,10,0,0"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                    <ItemsControl ItemsSource="{Binding SearchResults}" Margin="0,8,0,0"
                                  MaxHeight="220"
                                  Visibility="{Binding SearchResults.Count, Converter={StaticResource InverseEmptyVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F7F7F9" CornerRadius="10" Margin="0,3" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="13.5" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Stock, StringFormat=الرصيد: {0}}"
                                                       FontFamily="{StaticResource AppFont}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                                   FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                                   Foreground="{StaticResource TextPrimaryBrush}">
                                            <Run Text="{Binding BuyPrice, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                                        </TextBlock>
                                        <Button Grid.Column="2" Content="إضافة" Margin="16,0,0,0"
                                                Style="{StaticResource PrimaryButton}" Padding="14,6"
                                                FontSize="12.5" VerticalAlignment="Center"
                                                Command="{Binding DataContext.AddProductCommand,
                                                                  RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Text="الأصناف" Margin="0,18,0,0"
                       FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                <StackPanel>
                <!-- ===== رؤوس الأعمدة ===== -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="0.6*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="المنتج" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="الكمية" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="سعر الوحدة (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="الإجمالي (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppleListRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="0.6*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBox}"
                                                 inf:NumericInput.IsNumeric="True"
                                                 Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"/>

                                        <TextBox Grid.Column="2" Style="{StaticResource GridCellTextBox}"
                                                 inf:NumericInput.IsDecimal="True"
                                                 Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                 VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="3" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding LineTotal, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        </TextBlock>

                                        <Button Grid.Column="4" Content="&#xE74D;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Style="{StaticResource DangerButton}" Padding="8,4" FontSize="12"
                                                ToolTip="إزالة"
                                                Command="{Binding DataContext.RemoveItemCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="لا توجد أصناف"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8"
                           Visibility="{Binding Items.Count, Converter={StaticResource EmptyVisibility}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- ===== الأسفل ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="الإجمالي:" FontFamily="{StaticResource AppFont}"
                               FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0">
                        <Run Text="{Binding Total, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                    </TextBlock>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ResultMessage}" Margin="16,0,0,0"
                           FontFamily="{StaticResource AppFont}" FontSize="12.5"
                           Foreground="{Binding IsResultError, Converter={StaticResource ResultColor}}"
                           VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="حفظ التعديلات" Margin="16,0,0,0"
                        Style="{StaticResource PrimaryButton}" Padding="26,10"
                        Command="{Binding SaveCommand}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
