<Window x:Class="PhoneAccounting.App.Views.RepairReceiveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="استقبال جهاز للصيانة"
        Width="640" Height="720"
        MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{StaticResource GlassBgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة الزجاجية ===== -->
        <Border Grid.Row="0" Style="{StaticResource UiverseGradientCard}"
                Margin="16,16,16,0" Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="استقبال جهاز جديد" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold"
                               Foreground="{StaticResource OnPrimaryBrush}"/>
                    <TextBlock Text="{Binding DateText}" FontFamily="{StaticResource AppFont}"
                               FontSize="12" Foreground="#E8E8F0"
                               Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}"
                        FontFamily="Segoe MDL2 Assets" FontSize="14"
                        ToolTip="إلغاء" Click="Close_Click"
                        Foreground="{StaticResource OnPrimaryBrush}"/>
            </Grid>
        </Border>

        <!-- ===== المحتوى ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,20,24,0">
                <!-- بطاقة العميل الزجاجية -->
                <Border Style="{StaticResource UiverseGradientCard}" Margin="0,0,0,14" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="بيانات العميل" FontFamily="{StaticResource AppFont}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="اسم العميل *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,18,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="رقم الهاتف" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                 inf:NumericInput.IsNumeric="True"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>
                    </StackPanel>
                </Border>

                <!-- بطاقة الجهاز الزجاجية -->
                <Border Style="{StaticResource UiverseGradientCard}" Margin="0,0,0,14" Padding="24,20">
                    <StackPanel>
                        <TextBlock Text="بيانات الجهاز" FontFamily="{StaticResource AppFont}"
                                   FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="نوع الجهاز / اسمه *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,18,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="مثال: آيفون 17 برو ماكس 256GB"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="وصف العطل *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Issue, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="88" Padding="12,10"
                                 VerticalContentAlignment="Top"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="ملاحظات" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap" AcceptsReturn="True" Height="72" Padding="12,10"
                                 VerticalContentAlignment="Top"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>

                        <TextBlock Text="أجرة الصيانة (د.ع) *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="#E0E0E8"
                                   Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding LaborFeeText, UpdateSourceTrigger=PropertyChanged}"
                                 inf:NumericInput.IsDecimal="True"
                                 Background="#1AFFFFFF" Foreground="{StaticResource OnPrimaryBrush}"
                                 BorderBrush="#3FFFFFFF" CaretBrush="{StaticResource OnPrimaryBrush}"/>
                        <TextBlock Text="تأخذ هذه القيمة من أجرة الصيانة الافتراضية ويمكن تعديلها"
                                   FontFamily="{StaticResource AppFont}" FontSize="11"
                                   Foreground="#A0A0B0" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="{Binding ResultMessage}" Margin="0,14,0,0"
                           FontFamily="{StaticResource AppFont}" FontSize="12.5"
                           Foreground="{Binding IsResultError, Converter={StaticResource ResultColor}}"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== الأزرار ===== -->
        <Border Grid.Row="2" Margin="16,0,16,16" Padding="22,14"
                Background="#0AFFFFFF" CornerRadius="14"
                BorderBrush="#1FFFFFFF" BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="إلغاء" Style="{StaticResource UiverseGhostButton}" Height="42"
                        Click="Close_Click"/>
                <Button Content="استقبال الجهاز" Style="{StaticResource UiverseNeonButton}" Height="42"
                        Margin="10,0,0,0" Command="{Binding SaveCommand}"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
