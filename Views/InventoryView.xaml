<UserControl x:Class="PhoneAccounting.App.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="جرد المخزون" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="عرض أرصدة الأصناف وقيمتها وتصدير تقرير الجرد"
                       FontFamily="{StaticResource AppFont}" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ===== شريط البحث والأزرار ===== -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="22,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="بحث" FontFamily="{StaticResource AppFont}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="بالبحث عن الاسم أو الباركود أو رقم IMEI"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,16,2">
                    <Button Style="{StaticResource ModernButton}" Command="{Binding RefreshCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" تحديث" FontFamily="{StaticResource AppFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Margin="10,0,0,0"
                            Command="{Binding PrintCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text=" طباعة التقرير" FontFamily="{StaticResource AppFont}"
                                       FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== بطاقات الملخص ===== -->
        <UniformGrid Grid.Row="2" Columns="5" Margin="0,16,0,0">

            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource SecondaryContainerBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE8C8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSecondaryContainerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="عدد الأصناف" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding TotalProducts}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource SecondaryContainerBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE7B8;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{StaticResource OnSecondaryContainerBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="إجمالي القطع" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding TotalUnits}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource TertiaryContainerBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="قيمة الجرد (تكلفة)" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="17" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding TotalValue, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FDECEA" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{Binding LowStockCount, Converter={StaticResource LowStockColor}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="منخفض المخزون" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding LowStockCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{Binding LowStockCount, Converter={StaticResource LowStockColor}}"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10" Background="#FDECEA" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="{Binding OutOfStockCount, Converter={StaticResource LowStockColor}}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="نافد" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding OutOfStockCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{Binding OutOfStockCount, Converter={StaticResource LowStockColor}}"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== جدول الجرد ===== -->
         <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
            <StackPanel>
            <!-- ===== رؤوس الأعمدة (تسميات فقط) ===== -->
            <Grid Margin="22,16,22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.4*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.9*"/>
                    <ColumnDefinition Width="0.8*"/>
                    <ColumnDefinition Width="1.1*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="رقم" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="1" Text="الباركود" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="2" Text="اسم المنتج" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="3" Text="التصنيف" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="4" Text="الجهاز" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="5" Text="سعر الشراء" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="6" Text="سعر البيع" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="7" Text="الكمية" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBlock Grid.Column="8" Text="القيمة (د.ع)" FontFamily="{StaticResource AppFont}"
                           FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
            </Grid>

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource AppleListRowBorder}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLow}" Value="True">
                                                        <Setter Property="Background" Value="#FFF4F0"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsOutOfStock}" Value="True">
                                                        <Setter Property="Background" Value="#FFEBE8"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="0.4*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="2*"/>
                                        <ColumnDefinition Width="1.2*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.9*"/>
                                        <ColumnDefinition Width="0.8*"/>
                                        <ColumnDefinition Width="1.1*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="{Binding Index}"
                                               FontFamily="{StaticResource AppFont}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="1" Text="{Binding Barcode}"
                                               FontFamily="{StaticResource AppFont}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                                               FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="3" Text="{Binding CategoryName}"
                                               FontFamily="{StaticResource AppFont}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="4" Text="{Binding DeviceName}"
                                               FontFamily="{StaticResource AppFont}" FontSize="13"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Column="5" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding BuyPrice, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="6" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding SellPrice, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="7" VerticalAlignment="Center"
                                               FontFamily="{StaticResource AppFont}">
                                        <Run Text="{Binding Stock, Mode=OneWay}" FontSize="14" FontWeight="Bold"
                                             Foreground="{Binding IsOutOfStock, Converter={StaticResource BoolToBrush}}"/>
                                        <Run Text="{Binding MinStock, StringFormat= / {0}, Mode=OneWay}"
                                             Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="8" FontFamily="{StaticResource AppFont}"
                                               FontSize="13" FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center">
                                        <Run Text="{Binding Value, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="لا توجد بيانات جرد مطابقة"
                       FontFamily="{StaticResource AppFont}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="22,18"
                        Visibility="{Binding Rows.Count, Converter={StaticResource EmptyVisibility}}"/>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</UserControl>
