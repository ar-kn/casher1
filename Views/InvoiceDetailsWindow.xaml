<Window x:Class="PhoneAccounting.App.Views.InvoiceDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="تفاصيل الفاتورة"
        Width="760" Height="620"
        MinWidth="640" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontFamily="{StaticResource AppFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="{Binding InvoiceNumber}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                        <TextBlock Text="{Binding KindText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding VoidButtonText}" Style="{StaticResource DangerButton}"
                            Padding="16,8" Margin="0,0,10,0" IsEnabled="{Binding CanVoid}"
                            ToolTip="{Binding VoidHelp}"
                            Click="Void_Click"/>
                    <Button Content="&#xE70F;" Style="{StaticResource IconButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="13"
                            ToolTip="تعديل الفاتورة"
                            Click="Edit_Click"/>
                    <Button Content="&#xE711;" Style="{StaticResource IconButton}"
                            FontFamily="Segoe MDL2 Assets" FontSize="13"
                            ToolTip="إغلاق" Click="Close_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== تفاصيل ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,0">

            <!-- بطاقة المعلومات -->
            <Border Style="{StaticResource Card}" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="التاريخ والوقت" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DateText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1">
                        <TextBlock Text="الموظف المسؤول" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding EmployeeName}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,0,0">
                        <TextBlock Text="الجهاز" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding DeviceText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,16,0,0">
                        <TextBlock Text="{Binding PartyLabel}" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PartyText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,16,0,0">
                        <TextBlock Text="طريقة الدفع" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding PaymentText}" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,16,0,0">
                        <TextBlock Text="الخصم" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding DiscountText, Mode=OneWay}"/><Run Text=" د.ع"/>
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,16,0,0">
                        <TextBlock Text="الربح" FontFamily="{StaticResource AppFont}"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBlock FontFamily="{StaticResource AppFont}" FontSize="14" FontWeight="SemiBold"
                                   Margin="0,4,0,0" Foreground="{StaticResource TextPrimaryBrush}">
                            <Run Text="{Binding ProfitText, Mode=OneWay}"/><Run Text=" د.ع"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- الأصناف -->
            <TextBlock Text="الأصناف" Margin="0,18,0,0"
                       FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <Border Style="{StaticResource Card}" Padding="0" Margin="0,10,0,0">
                <StackPanel>
                <!-- ===== رؤوس الأعمدة ===== -->
                <Grid Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="المنتج" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="الكمية" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="السعر (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="الإجمالي (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                </Grid>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppleListRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2.2*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="0" FontFamily="{StaticResource AppFont}" FontSize="10"
                                                   FontWeight="SemiBold" Foreground="#E6A23C"
                                                   Text="قيد المراجعة"
                                                   HorizontalAlignment="Left" Margin="0,20,0,0"
                                                   VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding UnderReview}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center"/>

                                        <TextBlock Grid.Column="2" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding UnitPrice, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        </TextBlock>

                                        <TextBlock Grid.Column="3" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center">
                                            <Run Text="{Binding LineTotal, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Text="لا توجد أصناف"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8"
                           Visibility="{Binding Items.Count, Converter={StaticResource EmptyVisibility}}"/>
                </StackPanel>
            </Border>
        </StackPanel>
        </ScrollViewer>

        <!-- ===== الأسفل ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ActionMessage}" Grid.Column="0"
                           FontFamily="{StaticResource AppFont}" FontSize="12.5"
                           VerticalAlignment="Center" Margin="0,0,16,0" TextWrapping="Wrap"
                           Visibility="{Binding ActionMessage, Converter={StaticResource EmptyVisibility}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActionIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="إجمالي الفاتورة:" FontFamily="{StaticResource AppFont}"
                               FontSize="15" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource AccentBrush}" Margin="10,0,0,0">
                        <Run Text="{Binding Total, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                    </TextBlock>
                </StackPanel>
                <Button Grid.Column="2" Content="إغلاق" Style="{StaticResource ModernButton}"
                        Margin="16,0,0,0" Click="Close_Click" Padding="28,9"/>
            </Grid>
        </Border>
    </Grid>
</Window>
