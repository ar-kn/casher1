<Window x:Class="PhoneAccounting.App.Views.SupplierDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="بيانات المورد"
        Width="520" SizeToContent="Height"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="بيانات المورد" FontFamily="{StaticResource AppFont}"
                               FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="المشتريات والرصيد المستحق" FontFamily="{StaticResource AppFont}"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE711;" Style="{StaticResource IconButton}"
                        FontFamily="Segoe MDL2 Assets" FontSize="13" Click="Close_Click"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource AppleGlassCard}" Margin="22,20" Padding="24">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="{StaticResource GlassTertiaryTintBrush}">
                        <TextBlock Text="&#xE8C7;" Style="{StaticResource CenteredGlyphIcon}" FontSize="22"
                                   Foreground="{StaticResource GlassPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="NameText" FontFamily="{StaticResource AppFont}" FontSize="20" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="PhoneText" FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Border Background="{StaticResource GlassSurfaceContainerBrush}" CornerRadius="14" Margin="0,18,0,0"
                        Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="الرصيد المستحق للمورد" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource GlassOutlineBrush}"/>
                            <TextBlock x:Name="BalanceText" FontFamily="{StaticResource AppFont}" FontSize="22"
                                       FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Border Grid.Column="1" Width="40" Height="40" CornerRadius="12"
                                Background="{StaticResource GlassErrorTintBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE7A5;" Style="{StaticResource CenteredGlyphIcon}" FontSize="17"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="عدد فواتير الشراء" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Foreground="{StaticResource GlassOutlineBrush}"/>
                        <TextBlock x:Name="PurchasesCountText" FontFamily="{StaticResource AppFont}" FontSize="18"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="إجمالي المشتريات" FontFamily="{StaticResource AppFont}"
                                   FontSize="11.5" Foreground="{StaticResource GlassOutlineBrush}"/>
                        <TextBlock x:Name="PurchasesTotalText" FontFamily="{StaticResource AppFont}" FontSize="18"
                                   FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="0,16,0,0">
                    <TextBlock Text="آخر عملية شراء" FontFamily="{StaticResource AppFont}"
                               FontSize="11.5" Foreground="{StaticResource GlassOutlineBrush}"/>
                    <TextBlock x:Name="LastPurchaseText" FontFamily="{StaticResource AppFont}" FontSize="13"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,5,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>