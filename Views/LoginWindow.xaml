<Window x:Class="PhoneAccounting.App.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoneAccounting.App.ViewModels"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="تسجيل الدخول"
        Width="860" Height="540"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <inf:InverseBooleanConverter x:Key="InverseBoolean"/>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- ===== الجهة اليسرى (عرض تسويقي) ===== -->
        <Grid Grid.Column="0" Background="#0A1F3C">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28"
                    Padding="16,8" CornerRadius="24" Background="#1C3860">
                <TextBlock Text="نظام المحاسبة" Foreground="White" FontSize="15"
                           FontFamily="{StaticResource AppFont}" FontWeight="SemiBold"/>
            </Border>

            <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="48,0">
                <TextBlock Text="{Binding CompanyName}"
                           Foreground="White" FontSize="34" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}"
                           TextWrapping="Wrap"/>
                <TextBlock Text="لشركة بيع الهواتف والإكسسوارات وقطع الغيار"
                           Foreground="#9AB6D9" FontSize="15" Margin="0,12,0,0"
                           FontFamily="{StaticResource AppFont}"/>
                <TextBlock Text="المبيعات · المشتريات · الصيانة · المخزون · المحاسبة"
                           Foreground="#6E8BB0" FontSize="13" Margin="0,6,0,0"
                           FontFamily="{StaticResource AppFont}"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Margin="0,0,0,20" HorizontalAlignment="Center"
                       Text="يعمل دون اتصال بالإنترنت — آمن من انقطاع الكهرباء"
                       Foreground="#6E8BB0" FontSize="12"
                       FontFamily="{StaticResource AppFont}"/>
        </Grid>

        <!-- ===== نموذج الدخول ===== -->
        <Grid Grid.Column="1" Background="White">
            <StackPanel VerticalAlignment="Center" Margin="40,0" MaxWidth="300">
                <TextBlock Text="تسجيل الدخول" FontSize="26" FontWeight="Bold"
                           FontFamily="{StaticResource AppFont}"
                           Foreground="{StaticResource TextPrimaryBrush}"/>

                <TextBlock Text="اسم المستخدم" Margin="0,28,0,6"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <TextBox x:Name="UsernameBox"
                         Style="{StaticResource ModernTextBox}"
                         Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/>

                <TextBlock Text="كلمة المرور" Margin="0,16,0,6"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="PasswordBox"
                             Style="{StaticResource ModernPasswordBox}"
                             KeyDown="PasswordBox_KeyDown"
                             PasswordChanged="PasswordBox_PasswordChanged"/>

                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           FontSize="12.5" Margin="0,12,0,0"
                           TextWrapping="Wrap"
                           FontFamily="{StaticResource AppFont}"/>

                <Button Content="دخول"
                        Style="{StaticResource PrimaryButton}"
                        Margin="0,22,0,0"
                        Command="{Binding LoginCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolean}}">
                    <Button.Triggers>
                        <EventTrigger RoutedEvent="Button.Click">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                     From="1" To="0.7" Duration="0:0:0.1"
                                                     AutoReverse="True"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Button.Triggers>
                </Button>

                <TextBlock Text="أمان: كلمات المرور مخزّنة مشفّرة وغير قابلة للاسترجاع"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           FontSize="12" Margin="0,18,0,0" HorizontalAlignment="Center"
                           FontFamily="{StaticResource AppFont}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
