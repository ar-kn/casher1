<Window x:Class="PhoneAccounting.App.Views.RepairJobEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="تفاصيل قطعة الصيانة"
        Width="960" Height="760"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                Padding="22,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource AccentBrush}"
                        CornerRadius="10" Padding="16,6">
                    <StackPanel>
                        <TextBlock Text="قطعة الصيانة" Foreground="#BFD9FF" FontSize="10.5"
                                   FontFamily="{StaticResource AppFont}" HorizontalAlignment="Center"/>
                        <TextBlock Text="{Binding JobNumber}" Foreground="White" FontSize="17"
                                   FontWeight="Bold" FontFamily="{StaticResource AppFont}"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ReceivedDateText}" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Text="تاريخ الاستقبال" FontFamily="{StaticResource AppFont}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}"
                        FontFamily="Segoe MDL2 Assets" FontSize="13"
                        ToolTip="إغلاق" Click="Close_Click"/>
            </Grid>
        </Border>

        <!-- ===== المحتوى ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,18,24,0">

                <!-- ===== بيانات القطعة ===== -->
                <Border Style="{StaticResource Card}" Padding="22,18"
                        IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBoolean}}">
                    <StackPanel>
                        <TextBlock Text="بيانات القطعة" FontFamily="{StaticResource AppFont}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="اسم العميل *" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                <TextBlock Text="رقم الهاتف" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,6"/>
                                <TextBox Style="{StaticResource ModernTextBox}"
                                         Text="{Binding CustomerPhone, UpdateSourceTrigger=PropertyChanged}"
                                         inf:NumericInput.IsNumeric="True"/>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="نوع الجهاز / اسمه *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,6"/>
                        <TextBox Style="{StaticResource ModernTextBox}"
                                 Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}"/>

                        <TextBlock Text="وصف العطل *" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,6"/>
                          <TextBox Style="{StaticResource ModernTextBox}"
                                  Text="{Binding Issue, UpdateSourceTrigger=PropertyChanged}"
                                  TextWrapping="Wrap" AcceptsReturn="True" Height="64" Padding="12,10"
                                  VerticalContentAlignment="Top"/>

                        <TextBlock Text="ملاحظات" FontFamily="{StaticResource AppFont}"
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   Margin="0,14,0,6"/>
                          <TextBox Style="{StaticResource ModernTextBox}"
                                  Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                  TextWrapping="Wrap" AcceptsReturn="True" Height="56" Padding="12,10"
                                  VerticalContentAlignment="Top"/>
                    </StackPanel>
                </Border>

                <!-- ===== الحالة والدفع ===== -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="22,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="حالة القطعة" FontFamily="{StaticResource AppFont}"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding StatusOptions}"
                                      SelectedItem="{Binding Status}"
                                      DisplayMemberPath="Display"
                                      IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBoolean}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,0">
                            <TextBlock Text="طريقة الدفع" FontFamily="{StaticResource AppFont}"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <ComboBox Style="{StaticResource ModernComboBox}"
                                      ItemsSource="{Binding PaymentMethods}"
                                      SelectedItem="{Binding Payment}"
                                      DisplayMemberPath="Display"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,16,12,0">
                            <TextBlock Text="أجرة الصيانة (د.ع)" FontFamily="{StaticResource AppFont}"
                                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                       Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding LaborFee, StringFormat={}{0:0}, UpdateSourceTrigger=PropertyChanged}"
                                     inf:NumericInput.IsDecimal="True"
                                     IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBoolean}}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,16,0,0" VerticalAlignment="Bottom">
                            <CheckBox Content="تم تحصيل المبلغ"
                                      IsChecked="{Binding IsPaid}"
                                      FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                      Foreground="{StaticResource TextPrimaryBrush}"
                                      VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2"
                                Background="{StaticResource NavSelectedBrush}"
                                CornerRadius="12" Padding="26,14" Margin="16,0,0,0"
                                VerticalAlignment="Stretch">
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="الإجمالي" FontFamily="{StaticResource AppFont}"
                                           FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="24" FontWeight="Bold"
                                           Foreground="{StaticResource AccentBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0">
                                    <Run Text="{Binding Total, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                                </TextBlock>
                                <TextBlock Text="{Binding PartsTotal, StringFormat=قطع الغيار: {0:N0} د.ع}"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2"
                                   Text="{Binding ResultMessage}" Margin="0,14,0,0"
                                   FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                   Foreground="{Binding IsResultError, Converter={StaticResource ResultColor}}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <!-- ===== قطع الغيار ===== -->
                <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="22,18"
                        IsEnabled="{Binding IsClosed, Converter={StaticResource InverseBoolean}}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="قطع الغيار المستخدمة" FontFamily="{StaticResource AppFont}"
                                           FontSize="14" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="ابحث عن قطعة لإضافتها — تُخصم من المخزون تلقائياً وتُضاف قيمتها للفاتورة"
                                           FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Style="{StaticResource ModernTextBox}" Width="280"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="16,0,0,0"/>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,12,0,0"
                                Visibility="{Binding SearchResults.Count, Converter={StaticResource InverseEmptyVisibility}}">
                            <ItemsControl ItemsSource="{Binding SearchResults}" MaxHeight="200">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#F7F7F9" CornerRadius="10" Margin="0,3"
                                                Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                           Text="{Binding Name}"
                                                           FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                                           FontWeight="SemiBold"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Grid.Column="1" Margin="16,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                                           Foreground="{StaticResource TextPrimaryBrush}">
                                                    <Run Text="السعر: "/><Run Text="{Binding SellPrice, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                                                </TextBlock>
                                                <TextBlock Grid.Column="2" Margin="16,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                                           Foreground="{StaticResource TextSecondaryBrush}">
                                                    <Run Text="المتاح: "/><Run Text="{Binding Stock, Mode=OneWay}"/>
                                                </TextBlock>
                                                <Button Grid.Column="3" Content="إضافة" Margin="16,0,0,0"
                                                        Style="{StaticResource PrimaryButton}" Padding="14,6"
                                                        FontSize="12.5" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.AddPartCommand,
                                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>

                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <!-- ===== رؤوس الأعمدة ===== -->
                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.4*"/>
                                    <ColumnDefinition Width="0.8*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="1.1*"/>
                                    <ColumnDefinition Width="0.6*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="القطعة" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="الكمية" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="2" Text="سعر الوحدة (د.ع)" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="الإجمالي (د.ع)" FontFamily="{StaticResource AppFont}"
                                           FontSize="12.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Grid>

                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,6,0,0">
                                <ItemsControl ItemsSource="{Binding Parts}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource AppleListRowBorder}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="2.4*"/>
                                                        <ColumnDefinition Width="0.8*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="1.1*"/>
                                                        <ColumnDefinition Width="0.6*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding ProductName}"
                                                               FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                                               FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center"/>

                                                    <TextBox Grid.Column="1" Style="{StaticResource GridCellTextBox}"
                                                             inf:NumericInput.IsNumeric="True"
                                                             Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"/>

                                                    <TextBox Grid.Column="2" Style="{StaticResource GridCellTextBox}"
                                                             inf:NumericInput.IsDecimal="True"
                                                             Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}"
                                                             VerticalAlignment="Center"/>

                                                    <TextBlock Grid.Column="3" FontFamily="{StaticResource AppFont}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               VerticalAlignment="Center">
                                                        <Run Text="{Binding LineTotal, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                    </TextBlock>

                                                    <Button Grid.Column="4" Content="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Style="{StaticResource DangerButton}" Padding="8,4" FontSize="13"
                                                            ToolTip="إزالة"
                                                            Command="{Binding DataContext.RemovePartCommand,
                                                                      RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="لا توجد قطع بحث حالياً"
                                       FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8"
                                       Visibility="{Binding Parts.Count, Converter={StaticResource EmptyVisibility}}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== الأزرار ===== -->
        <Border Grid.Row="2" Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ التغييرات" Style="{StaticResource PrimaryButton}" Height="42"
                        Command="{Binding SaveCommand}"
                        Visibility="{Binding IsClosed, Converter={StaticResource InverseBoolToVisibility}}"/>
                <Button Content="إغلاق" Style="{StaticResource ModernButton}" Height="42"
                        Margin="10,0,0,0" Click="Close_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
