<Window x:Class="PhoneAccounting.App.Views.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PhoneAccounting.App.ViewModels"
        xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
        Title="تغيير كلمة المرور"
        Width="460" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="White"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <inf:InverseBooleanConverter x:Key="InverseBoolean"/>
    </Window.Resources>

    <Grid Background="White">
        <StackPanel VerticalAlignment="Center" Margin="44,0" MaxWidth="330">
            <TextBlock Text="تغيير كلمة المرور" FontSize="24" FontWeight="Bold"
                       FontFamily="{StaticResource AppFont}"
                       Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Text="{Binding Hint}" Margin="0,10,0,0"
                       FontFamily="{StaticResource AppFont}" FontSize="12.5"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       TextWrapping="Wrap"/>

            <TextBlock Text="كلمة المرور الحالية" Margin="0,22,0,6"
                       FontFamily="{StaticResource AppFont}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="CurrentBox"
                         Style="{StaticResource ModernPasswordBox}"
                         PasswordChanged="Box_PasswordChanged"/>

            <TextBlock Text="كلمة المرور الجديدة" Margin="0,16,0,6"
                       FontFamily="{StaticResource AppFont}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="NewPasswordBox"
                         Style="{StaticResource ModernPasswordBox}"
                         PasswordChanged="Box_PasswordChanged"/>
            <TextBlock Text="8 أحرف على الأقل وتحتوي حرفاً ورقماً" Margin="0,6,2,0"
                       FontFamily="{StaticResource AppFont}" FontSize="11.5"
                       Foreground="{StaticResource TextSecondaryBrush}"/>

            <TextBlock Text="تأكيد كلمة المرور" Margin="0,16,0,6"
                       FontFamily="{StaticResource AppFont}" FontSize="13"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <PasswordBox x:Name="ConfirmBox"
                         Style="{StaticResource ModernPasswordBox}"
                         KeyDown="Box_KeyDown"
                         PasswordChanged="Box_PasswordChanged"/>

            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="{StaticResource DangerBrush}"
                       FontSize="12.5" Margin="0,12,0,0"
                       TextWrapping="Wrap"
                       FontFamily="{StaticResource AppFont}"/>

            <Button Content="حفظ كلمة المرور"
                    Style="{StaticResource PrimaryButton}"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Stretch"
                    Height="46"
                    Command="{Binding SaveCommand}">
            </Button>
        </StackPanel>
    </Grid>
</Window>