<Window x:Class="PhoneAccounting.App.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إدخال نص"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft"
        Background="{StaticResource BgBrush}"
        SourceInitialized="Window_SourceInitialized">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Style="{StaticResource AppleGlassCard}" Margin="18" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="TitleText" FontFamily="{StaticResource AppFont}"
                       FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>

            <TextBlock Grid.Row="1" x:Name="PromptText" FontFamily="{StaticResource AppFont}"
                       FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,8"/>

            <TextBox Grid.Row="1" x:Name="InputValue" Style="{StaticResource ModernTextBox}"
                     Margin="0,34,0,0" KeyDown="InputValue_KeyDown"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button Content="حفظ" Style="{StaticResource ApplePrimaryButton}" MinWidth="96" Height="36"
                        Click="Ok_Click"/>
                <Button Content="إلغاء" Style="{StaticResource AppleGhostButton}" MinWidth="96" Height="36"
                        Margin="10,0,0,0" Click="Cancel_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>