<UserControl x:Class="PhoneAccounting.App.Views.MaintenanceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:inf="clr-namespace:PhoneAccounting.App.Infrastructure"
             FlowDirection="RightToLeft"
             Background="{StaticResource BgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== الترويسة ===== -->
        <StackPanel Grid.Row="0">
            <TextBlock Text="الصيانة" Style="{StaticResource PageTitle}"/>
            <TextBlock Text="استقبال الأجهزة، تتبع سير الإصلاح، وقطع الغيار المستخدمة"
                       FontFamily="{StaticResource AppFont}" FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- ===== بطاقات الملخص ===== -->
        <UniformGrid Grid.Row="1" Columns="5" Margin="0,20,0,0">
            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource StatusReceivedBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مستلم" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding ReceivedCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource StatusReceivedBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource StatusInProgressBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="قيد الإصلاح" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding InProgressCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource StatusInProgressBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource StatusCompletedBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="منتهي" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding CompletedCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource StatusCompletedBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Margin="0,0,10,0" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource StatusDeliveredBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE7D2;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مسلّم" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding DeliveredCount}" FontFamily="{StaticResource AppFont}"
                               FontSize="20" FontWeight="Bold" Margin="0,4,0,0"
                               Foreground="{StaticResource StatusDeliveredBrush}"/>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource GlassCard}" Padding="16">
                <StackPanel>
                    <Border Width="38" Height="38" CornerRadius="10"
                            Background="{StaticResource DangerBrush}" HorizontalAlignment="Right">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="مبالغ غير محصّلة" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,10,0,0"/>
                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="17" FontWeight="Bold"
                               Margin="0,4,0,0" Foreground="{StaticResource DangerBrush}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding PendingAmount, StringFormat={}{0:N0}, Mode=OneWay}"/><Run Text=" د.ع"/>
                    </TextBlock>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- ===== شريط الأدوات ===== -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="22,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="البحث (العميل، الجهاز، رقم القطعة)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <TextBox Style="{StaticResource ModernTextBox}"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,16,0">
                    <TextBlock Text="الحالة" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <ComboBox Style="{StaticResource ModernComboBox}" Width="150"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter}"
                              DisplayMemberPath="Display"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,16,0">
                    <TextBlock Text="أجرة الصيانة الافتراضية (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Style="{StaticResource ModernTextBox}"
                                 inf:NumericInput.IsDecimal="True"
                                 Text="{Binding DefaultFeeText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Grid.Column="1" Content="حفظ" Margin="8,0,0,0"
                                Style="{StaticResource ModernButton}" Padding="14,8"
                                FontSize="12.5" VerticalAlignment="Stretch"
                                Command="{Binding SaveDefaultFeeCommand}"/>
                    </Grid>
                </StackPanel>

                <Button Grid.Column="3" Content="استقبال جهاز جديد"
                        Style="{StaticResource PrimaryButton}" Height="38"
                        VerticalAlignment="Bottom"
                        Command="{Binding OpenReceiveJobCommand}"/>
            </Grid>
        </Border>

        <!-- ===== قائمة قطع الصيانة ===== -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="22,18,22,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="قطع الصيانة" FontFamily="{StaticResource AppFont}"
                               FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Jobs.Count, StringFormat= ({0} قطعة)}"
                               FontFamily="{StaticResource AppFont}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <!-- ===== رأس أعمدة القائمة (تسميات فقط، بلا صناديق أو خطوط ثقيلة) ===== -->
                <Grid Grid.Row="1" Margin="26,14,26,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="1.5*"/>
                        <ColumnDefinition Width="1.7*"/>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="0.9*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="رقم القطعة" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="العميل / الجهاز" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="2" Text="العطل" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="3" Text="الحالة" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="4" Text="الإجمالي (د.ع)" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Left"/>
                    <TextBlock Grid.Column="5" Text="الدفع" FontFamily="{StaticResource AppFont}"
                               FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Left"/>
                </Grid>

                <!-- ===== قائمة القطع: صفوف نظيفة قابلة للنقر بأكملها، بلا شبكة أو تحديد صاخب ===== -->
                <ItemsControl Grid.Row="2" ItemsSource="{Binding Jobs}" Margin="0,4,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                                <Button Style="{StaticResource AppleListRow}" ToolTip="عرض تفاصيل القطعة"
                                        Command="{Binding DataContext.OpenJobCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                        CommandParameter="{Binding}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="1.5*"/>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="1*"/>
                                            <ColumnDefinition Width="0.9*"/>
                                            <ColumnDefinition Width="0.7*"/>
                                            <ColumnDefinition Width="20"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding JobNumber}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ReceivedDateText}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Opacity="0.75" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,14,0">
                                            <TextBlock Text="{Binding CustomerName}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="14" FontWeight="Medium"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DeviceName}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding Issue}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" Margin="0,0,14,0"
                                                   TextTrimming="CharacterEllipsis"/>

                                        <Border Grid.Column="3" Style="{StaticResource StatusPill}"
                                                Background="{Binding StatusBrush}" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Width="6" Height="6" Fill="White" Opacity="0.85"
                                                         VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding StatusText}" Foreground="White"
                                                           FontSize="11.5" FontFamily="{StaticResource AppFont}"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N0}}"
                                                   FontFamily="{StaticResource AppFont}" FontSize="13.5"
                                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Column="5" Text="{Binding PaidText}"
                                                   Foreground="{Binding PaidBrush}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   HorizontalAlignment="Left"/>

                                        <TextBlock Grid.Column="6" Text="&#xE76B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"
                                                   Opacity="0.5" VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"/>
                                    </Grid>
                                </Button>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Grid.Row="2" Text="لا توجد قطع صيانة مطابقة"
                           FontFamily="{StaticResource AppFont}" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="22,18"
                           Visibility="{Binding Jobs.Count, Converter={StaticResource EmptyVisibility}}"/>
            </Grid>
        </Border>

        <!-- ===== رسالة ===== -->
        <TextBlock Grid.Row="4" Text="{Binding ResultMessage}" Margin="0,14,0,0"
                   FontFamily="{StaticResource AppFont}" FontSize="12.5"
                   Foreground="{Binding IsResultError, Converter={StaticResource ResultColor}}"
                   TextWrapping="Wrap"/>
    </Grid>
    </ScrollViewer>
</UserControl>
