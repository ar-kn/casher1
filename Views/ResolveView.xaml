<UserControl x:Class="PhoneAccounting.App.Views.ResolveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:PhoneAccounting.App.ViewModels"
             FlowDirection="RightToLeft"
             Background="{StaticResource GlassBgBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28" MaxWidth="1200" HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ===== الترويسة: عنوان + وصف + تحديث ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="الخلافات وقرارها" FontFamily="{StaticResource AppFont}"
                                   FontSize="26" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="{StaticResource GlassTertiaryTintBrush}" CornerRadius="10"
                                Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="P3.2B" FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="استطلاع قراءة-فقط لخوادم الأوراق — لا صف صراع محلي على MAIN، والحسم عملية موقّعة"
                               FontFamily="{StaticResource AppFont}" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Message}" FontFamily="{StaticResource AppFont}" FontSize="12.5"
                               Foreground="{StaticResource GlassPrimaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ApplePrimaryButton}" Height="42"
                            Command="{Binding RefreshActionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Text="حدّث" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== قائمة الخلافات المدمجة بالـ SyncId ===== -->
            <Border Grid.Row="1" Style="{StaticResource AppleGlassCard}" Padding="20" Margin="0,20,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="الخلافات المفتوحة" FontFamily="{StaticResource AppFont}"
                                   FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <Border Background="{StaticResource GlassErrorTintBrush}" CornerRadius="10"
                                Padding="9,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Pending.Count}" FontFamily="{StaticResource AppFont}" FontSize="11"
                                       FontWeight="Bold" Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="لا خلافات مفتوحة — الشبكة نظيفة"
                               FontFamily="{StaticResource AppFont}" FontSize="13" Foreground="{StaticResource GlassOutlineBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,8"
                               Visibility="{Binding Pending.Count, Converter={StaticResource EmptyVisibility}}"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Pending}" SelectedItem="{Binding SelectedRow}"
                             Background="{StaticResource GlassSurfaceContainerBrush}"
                             BorderThickness="0"
                             Visibility="{Binding Pending.Count, Converter={StaticResource InverseEmptyVisibility}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ResolveConflictRow}">
                                <Border Padding="4,9" BorderBrush="{StaticResource GlassSurfaceContainerHighBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.7*"/>
                                            <ColumnDefinition Width="1.2*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.1*"/>
                                            <ColumnDefinition Width="1.3*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding SyncId}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="10.5" Foreground="{StaticResource GlassOutlineBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding Sources}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" Foreground="{StaticResource GlassPrimaryBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <TextBlock Text="عندنا" FontFamily="{StaticResource AppFont}" FontSize="9"
                                                       Foreground="{StaticResource GlassOutlineBrush}"/>
                                            <TextBlock Text="{Binding LocalValueText}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                            <TextBlock Text="الآخر" FontFamily="{StaticResource AppFont}" FontSize="9"
                                                       Foreground="{StaticResource GlassOutlineBrush}"/>
                                            <TextBlock Text="{Binding RemoteValueText}" FontFamily="{StaticResource AppFont}"
                                                       FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="4" Text="{Binding Decision}" FontFamily="{StaticResource AppFont}"
                                                   FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- ===== منطقة الحسم — على MAIN فقط (IsMain) ===== -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,16,0,0"
                                Visibility="{Binding IsMain, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="القرار المحسوم سيوزَّع كعملية موقّعة على كل الأوراق (تحقّق من طزاجة المُبلِّغ أولاً)"
                                   FontFamily="{StaticResource AppFont}" FontSize="11.5"
                                   Foreground="{StaticResource GlassOutlineBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button Style="{StaticResource ApplePrimaryButton}" Height="38" Padding="14,0"
                                Command="{Binding ResolveKeepLocalCommand}"
                                Content="أبقِ قيمتنا المحلية"/>
                        <Button Style="{StaticResource AppleGhostButton}" Height="38" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding ResolveKeepRemoteCommand}"
                                Content="اعتمد قيمة الآخر"/>
                        <Button Style="{StaticResource AppleGhostButton}" Height="38" Padding="14,0" Margin="8,0,0,0"
                                Command="{Binding ResolveStaysDeletedCommand}"
                                Content="يبقى محذوفاً"/>
                    </StackPanel>

                    <TextBlock Grid.Row="3" FontFamily="{StaticResource AppFont}" FontSize="11.5"
                               Foreground="{StaticResource GlassOutlineBrush}" Margin="0,16,0,0"
                               Text="الحسم متاح من جهاز MAIN فقط — الأفرع لا تظهر الأزرار"
                               Visibility="{Binding IsMain, Converter={StaticResource InverseBoolToVisibility}}"/>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>