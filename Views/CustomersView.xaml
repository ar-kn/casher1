<UserControl x:Class="PhoneAccounting.App.Views.CustomersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft"
             Background="{StaticResource GlassBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28" MaxWidth="1400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== الترويسة ===== -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="14"
                            Background="{StaticResource GlassSurfaceContainerHighBrush}">
                        <TextBlock Text="&#xE716;" Style="{StaticResource CenteredGlyphIcon}" FontSize="19"
                                   Foreground="{StaticResource GlassPrimaryBrush}"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="دليل وحسابات العملاء" FontFamily="{StaticResource AppFont}"
                                       FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="{StaticResource GlassSurfaceContainerHighBrush}" CornerRadius="10"
                                    Padding="9,3" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource AppFont}" FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="{Binding CustomersCount}"/><Run Text=" عميل مسجّل"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="إدارة الأرصدة الائتمانية، فواتير المبيعات، وسجل السداد"
                                   FontFamily="{StaticResource AppFont}" FontSize="12"
                                   Foreground="{StaticResource GlassOutlineBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource AppleGhostButton}" Height="38"
                            Command="{Binding ExportCustomersCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="تصدير" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ApplePrimaryButton}" Height="38" Margin="10,0,0,0"
                            Command="{Binding StartAddCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="إضافة عميل جديد" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ===== بطاقات KPI ===== -->
            <Grid Grid.Row="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource AppleGlassCard}" Padding="20" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="إجمالي الذمم والمديونيات" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource GlassOutlineBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0">
                                <Run Text="{Binding TotalReceivables, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                <Run Text=" د.ع" FontSize="11" Foreground="{StaticResource GlassOutlineBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="14"
                                Background="{StaticResource GlassErrorTintBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE8C7;" Style="{StaticResource CenteredGlyphIcon}" FontSize="20"
                                       Foreground="{StaticResource DangerBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource AppleGlassCard}" Padding="20" Margin="6,0,6,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="عدد الزبائن المدينين" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource GlassOutlineBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,0">
                                <Run Text="{Binding DebtorsCount}"/>
                                <Run Text=" من " FontSize="11" Foreground="{StaticResource GlassOutlineBrush}"/>
                                <Run Text="{Binding CustomersCount}" FontSize="11" Foreground="{StaticResource GlassOutlineBrush}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="14"
                                Background="{StaticResource GlassSurfaceContainerHighBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE7D2;" Style="{StaticResource CenteredGlyphIcon}" FontSize="20"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource AppleGlassCard}" Padding="20" Margin="10,0,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="معدل التحصيل التراكمي" FontFamily="{StaticResource AppFont}"
                                       FontSize="12" Foreground="{StaticResource GlassOutlineBrush}"/>
                            <TextBlock FontFamily="{StaticResource AppFont}" FontSize="24" FontWeight="Bold"
                                       Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0">
                                <Run Text="{Binding CollectionRatePercent, StringFormat={}{0:0.#}%, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                        <Border Grid.Column="1" Width="46" Height="46" CornerRadius="14"
                                Background="{StaticResource GlassTertiaryTintBrush}" VerticalAlignment="Top">
                            <TextBlock Text="&#xE930;" Style="{StaticResource CenteredGlyphIcon}" FontSize="20"
                                       Foreground="{StaticResource SuccessBrush}"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ===== نموذج إضافة عميل ===== -->
            <Border Grid.Row="2" Style="{StaticResource AppleGlassCard}" Margin="0,16,0,0" Padding="20"
                    Visibility="{Binding IsAdding, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Text="إضافة عميل جديد" FontFamily="{StaticResource AppFont}" FontSize="15"
                               FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <TextBlock Text="اسم العميل" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,10,0">
                            <TextBlock Text="رقم الهاتف (اختياري)" FontFamily="{StaticResource AppFont}" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                            <TextBox Style="{StaticResource ModernTextBox}"
                                     Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                            <Button Content="حفظ" Style="{StaticResource ApplePrimaryButton}" Height="40"
                                    Command="{Binding SaveNewCustomerCommand}"/>
                            <Button Content="إلغاء" Style="{StaticResource AppleGhostButton}" Height="40" Margin="10,0,0,0"
                                    Command="{Binding CancelAddCommand}"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding ResultMessage}" FontFamily="{StaticResource AppFont}" FontSize="12"
                               Foreground="{Binding IsResultError, Converter={StaticResource ResultColor}}"
                               Margin="0,8,0,0"
                               Visibility="{Binding ResultMessage, Converter={StaticResource StringToVisibility}}"/>
                </StackPanel>
            </Border>

            <!-- ===== القسم الرئيسي: القائمة + لوحة التفاصيل ===== -->
            <Grid Grid.Row="3" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ===== الجدول الرئيسي ===== -->
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Border Style="{StaticResource AppleGlassCard}" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{StaticResource GlassSurfaceContainerHighBrush}"
                                    CornerRadius="10" Padding="3">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton Content="الكل" Style="{StaticResource AppleSegmentToggle}"
                                                  IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter=الكل}"/>
                                    <ToggleButton Content="مدينون" Style="{StaticResource AppleSegmentToggle}"
                                                  IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter=مدينون}"/>
                                    <ToggleButton Content="مسوّى" Style="{StaticResource AppleSegmentToggle}"
                                                  IsChecked="{Binding SelectedFilter, Converter={StaticResource StringEquals}, ConverterParameter=مسوّى}"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="{StaticResource CardBrush}" CornerRadius="10"
                                    BorderBrush="{StaticResource OutlineVariantBrush}" BorderThickness="1" Margin="10,0,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                               Foreground="{StaticResource GlassOutlineBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                    <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" Height="36"
                                             Margin="8,0,12,0" VerticalContentAlignment="Center"
                                             FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="بحث بالاسم أو رقم الهاتف"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource AppleGlassCard}" Margin="0,12,0,0" Padding="0">
                        <StackPanel>
                            <Grid Margin="20,16,20,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.6*"/>
                                    <ColumnDefinition Width="1.3*"/>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="0.9*"/>
                                    <ColumnDefinition Width="0.7*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="العميل" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlassOutlineBrush}"/>
                                <TextBlock Grid.Column="1" Text="الهاتف" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlassOutlineBrush}"/>
                                <TextBlock Grid.Column="2" Text="الرصيد الحالي" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlassOutlineBrush}"/>
                                <TextBlock Grid.Column="3" Text="آخر نشاط" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlassOutlineBrush}"/>
                                <TextBlock Grid.Column="4" Text="الفواتير" FontFamily="{StaticResource AppFont}"
                                           FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource GlassOutlineBrush}"/>
                            </Grid>

                            <TextBlock Text="لا يوجد عملاء مطابقون" FontFamily="{StaticResource AppFont}" FontSize="13"
                                       Foreground="{StaticResource GlassOutlineBrush}" Margin="20,24"
                                       Visibility="{Binding Customers.Count, Converter={StaticResource EmptyVisibility}}"/>

                            <ItemsControl Margin="0,8,0,10" ItemsSource="{Binding Customers}"
                                          Visibility="{Binding Customers.Count, Converter={StaticResource InverseEmptyVisibility}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="20,11" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource GlassSurfaceContainerHighBrush}"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource GlassPrimaryTintBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SelectCustomerCommand,
                                                                                RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                              CommandParameter="{Binding}"/>
                                            </Border.InputBindings>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.6*"/>
                                                    <ColumnDefinition Width="1.3*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="0.9*"/>
                                                    <ColumnDefinition Width="0.7*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border Width="30" Height="30" CornerRadius="15"
                                                            Background="{StaticResource GlassPrimaryTintBrush}">
                                                        <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}"
                                                                   Style="{StaticResource CenteredGlyphIcon}"
                                                                   FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{StaticResource GlassPrimaryBrush}"/>
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="13" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TextPrimaryBrush}"
                                                               Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <TextBlock Grid.Column="1" Text="{Binding Phone}" FontFamily="Consolas" FontSize="11.5"
                                                           Foreground="{StaticResource GlassOutlineBrush}" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="2" FontFamily="{StaticResource AppFont}" FontSize="12.5"
                                                           FontWeight="Bold" VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Balance, Converter={StaticResource GreaterThanZero}}" Value="True">
                                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Balance, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                                </TextBlock>

                                                <TextBlock Grid.Column="3" Text="{Binding LastActivityText}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="11.5" Foreground="{StaticResource GlassOutlineBrush}" VerticalAlignment="Center"/>

                                                <TextBlock Grid.Column="4" Text="{Binding InvoiceCount}" FontFamily="{StaticResource AppFont}"
                                                           FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== لوحة التفاصيل (Inspector) ===== -->
                <Border Grid.Column="1" Style="{StaticResource AppleGlassCard}" Padding="22" Margin="10,0,0,0"
                        VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="اختر عميلاً من القائمة لعرض تفاصيله"
                                   FontFamily="{StaticResource AppFont}" FontSize="13"
                                   Foreground="{StaticResource GlassOutlineBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,40"
                                   Visibility="{Binding SelectedCustomer, Converter={StaticResource NullToVisibility}}"/>

                        <StackPanel Visibility="{Binding SelectedCustomer, Converter={StaticResource NotNullToVisibility}}">
                            <!-- بطاقة الملف الشخصي -->
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="20"
                                        Background="{StaticResource GlassPrimaryBrush}" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCustomer.Name, Converter={StaticResource Initials}}"
                                               Style="{StaticResource CenteredGlyphIcon}"
                                               FontFamily="{StaticResource AppFont}" FontSize="22" FontWeight="Bold"
                                               Foreground="White"/>
                                </Border>
                                <TextBlock Text="{Binding SelectedCustomer.Name}" FontFamily="{StaticResource AppFont}"
                                           FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                           HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock Text="{Binding SelectedCustomer.Phone}" FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource GlassOutlineBrush}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                <Border Background="{StaticResource GlassSurfaceContainerHighBrush}" CornerRadius="10"
                                        Padding="10,4" Margin="0,10,0,0" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedCustomer.BalanceState, Mode=OneWay}"
                                               FontFamily="{StaticResource AppFont}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <!-- أزرار إجراء سريعة -->
                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource AppleGhostButton}" Height="60" Margin="0,0,5,0"
                                        Command="{Binding NewSaleForSelectedCommand}">
                                    <StackPanel>
                                        <TextBlock Text="&#xE7D2;" Style="{StaticResource CenteredGlyphIcon}" FontSize="18"
                                                   Foreground="{StaticResource GlassPrimaryBrush}"/>
                                        <TextBlock Text="فاتورة جديدة" FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" Style="{StaticResource AppleGhostButton}" Height="60" Margin="5,0,0,0"
                                        Command="{Binding NewVoucherForSelectedCommand}"
                                        IsEnabled="{Binding SelectedCustomer.Balance, Converter={StaticResource GreaterThanZero}}"
                                        ToolTip="متاح فقط عند وجود دين مستحق على العميل">
                                    <StackPanel>
                                        <TextBlock Text="&#xE8C7;" Style="{StaticResource CenteredGlyphIcon}" FontSize="18"
                                                   Foreground="{StaticResource SuccessBrush}"/>
                                        <TextBlock Text="سند قبض" FontFamily="{StaticResource AppFont}" FontSize="10.5"
                                                   Margin="0,4,0,0" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- ملخص الرصيد -->
                            <Border Background="{StaticResource GlassSurfaceContainerBrush}" CornerRadius="14"
                                    Padding="16" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الرصيد المستحق" FontFamily="{StaticResource AppFont}"
                                               FontSize="12" Foreground="{StaticResource GlassOutlineBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" FontFamily="{StaticResource AppFont}" FontSize="16" FontWeight="Bold"
                                               Foreground="{StaticResource DangerBrush}">
                                        <Run Text="{Binding SelectedCustomer.Balance, StringFormat={}{0:N0}, Mode=OneWay}"/>
                                        <Run Text=" د.ع" FontSize="10"/>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <!-- آخر العمليات -->
                            <TextBlock Text="آخر العمليات المالية" FontFamily="{StaticResource AppFont}"
                                       FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"
                                       Margin="0,20,0,10"/>

                            <TextBlock Text="لا توجد عمليات مسجّلة لهذا العميل بعد" FontFamily="{StaticResource AppFont}"
                                       FontSize="11.5" Foreground="{StaticResource GlassOutlineBrush}"
                                       Visibility="{Binding SelectedCustomerTransactions.Count, Converter={StaticResource EmptyVisibility}}"/>

                            <ItemsControl ItemsSource="{Binding SelectedCustomerTransactions}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource GlassSurfaceContainerBrush}" CornerRadius="12"
                                                Padding="10" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Border Width="30" Height="30" CornerRadius="9"
                                                        Background="{StaticResource GlassSurfaceContainerHighBrush}">
                                                    <TextBlock Text="{Binding IconGlyph}" Style="{StaticResource CenteredGlyphIcon}"
                                                               FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding TypeText}" FontFamily="{StaticResource AppFont}"
                                                               FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                    <TextBlock FontFamily="{StaticResource AppFont}" FontSize="10"
                                                               Foreground="{StaticResource GlassOutlineBrush}">
                                                        <Run Text="{Binding ReferenceText}"/><Run Text=" • "/><Run Text="{Binding DateText}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="12" FontWeight="Bold"
                                                           VerticalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Amount, Converter={StaticResource GreaterThanZero}}" Value="False">
                                                                    <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <Run Text="{Binding Amount, StringFormat={}{0:+#,##0;-#,##0;0}, Mode=OneWay}"/>
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
