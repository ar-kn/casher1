<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================================
         ملف إلهام من Uiverse — قصاصات زجاجية حديثة ومستقلة.
         لا يعدّل أي شاشة موجودة؛ كل فلشاته من Ressources الأساسي.
         يُستدعى من App.xaml (MergedDictionaries).
         اشتغلنا قاعدتين ثابتتَين في WPF هنا:
           1) داخل ControlTemplate.Triggers يُستهدف FrameworkElement فقط
              (Borders/Ellipses/Grids) — لا Effects ولا Transforms.
           2) الحركة عبر خاصية Margin، لا عبر RenderTransform.
         ================================================================ -->

    <!-- ================== القطعة 1 : بطاقة زجاجية متدرجة ================== -->
    <Style x:Key="UiverseGradientCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="16"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush" Value="{StaticResource GlassOutlineBrush}"/>
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource GlassPrimaryTintColor}" Offset="0"/>
                    <GradientStop Color="{StaticResource GlassSurfaceContainerColor}" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="20" ShadowDepth="2" Direction="270"
                                  Opacity="0.18" Color="{StaticResource GlassPrimaryDeepColor}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================== القطعة 2 : زر نيون متوهج ==================
         الهدف الوحيد في Triggers هو Border (NeonBody) — عنصر مرئي حقيقي.
         الوهج ناتج عن DropShadowEffect ثابت + حدّ أسمك عند التمرير. -->
    <Style x:Key="UiverseNeonButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="NeonBody"
                            Background="{StaticResource GlassPrimaryBrush}"
                            CornerRadius="14"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="1"
                            BorderBrush="{StaticResource GlassOutlineBrush}">
                        <Grid>
                            <Grid.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0.35"
                                                  Color="{StaticResource GlassPrimaryDeepColor}"/>
                            </Grid.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NeonBody" Property="Background" Value="{StaticResource GlassPrimaryDeepBrush}"/>
                            <Setter TargetName="NeonBody" Property="BorderThickness" Value="2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="NeonBody" Property="Background" Value="{StaticResource GlassPrimaryDeepBrush}"/>
                            <Setter TargetName="NeonBody" Property="Opacity" Value="0.86"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="NeonBody" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================== القطعة 3 : مفتاح زجاجي منزلِق ==================
         الحركة عبر Margin على الكرة (Ellipse) — لا RenderTransform إطلاقاً.
         الهدفان الموجودان: Track (Border) وKnob (Ellipse). -->
    <Style x:Key="UiverseGlassToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Track"
                                Width="54" Height="30"
                                CornerRadius="15"
                                Background="{StaticResource GlassSurfaceContainerBrush}"
                                BorderBrush="{StaticResource GlassOutlineBrush}"
                                BorderThickness="1"/>
                        <Ellipse x:Name="Knob"
                                 Width="22" Height="22"
                                 Fill="{StaticResource OnPrimaryBrush}"
                                 Margin="4,0,0,0"
                                 HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource GlassPrimaryBrush}"/>
                            <Setter TargetName="Knob" Property="Margin" Value="28,0,0,0"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
