<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Easing ===== -->
    <BounceEase x:Key="BounceEase" Bounces="2" Bounciness="0.6" EasingMode="EaseOut"/>

    <!-- ===== لوحة الألوان (Material / Indigo) ===== -->
    <Color x:Key="BgColor">#F8F9FF</Color>
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}"/>

    <Color x:Key="CardColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}"/>

    <Color x:Key="AccentColor">#3525CD</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>

    <Color x:Key="AccentHoverColor">#4F46E5</Color>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}"/>

    <Color x:Key="PrimaryContainerColor">#4F46E5</Color>
    <SolidColorBrush x:Key="PrimaryContainerBrush" Color="{StaticResource PrimaryContainerColor}"/>

    <Color x:Key="TextPrimaryColor">#0B1C30</Color>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}"/>

    <Color x:Key="TextSecondaryColor">#464555</Color>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}"/>

    <Color x:Key="OnPrimaryColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimaryColor}"/>

    <Color x:Key="DividerColor">#E5E9F2</Color>
    <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource DividerColor}"/>

    <Color x:Key="OutlineVariantColor">#C7C4D8</Color>
    <SolidColorBrush x:Key="OutlineVariantBrush" Color="{StaticResource OutlineVariantColor}"/>

    <!-- الشريط الجانبي الداكن -->
    <Color x:Key="SidebarColor">#0B1C30</Color>
    <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}"/>

    <Color x:Key="SidebarTextColor">#AEBAE0</Color>
    <SolidColorBrush x:Key="SidebarTextBrush" Color="{StaticResource SidebarTextColor}"/>

    <Color x:Key="SidebarTextActiveColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="SidebarTextActiveBrush" Color="{StaticResource SidebarTextActiveColor}"/>

    <Color x:Key="NavHoverColor">#1C2C44</Color>
    <SolidColorBrush x:Key="NavHoverBrush" Color="{StaticResource NavHoverColor}"/>

    <Color x:Key="NavSelectedColor">#3525CD</Color>
    <SolidColorBrush x:Key="NavSelectedBrush" Color="{StaticResource NavSelectedColor}"/>

    <Color x:Key="DangerColor">#BA1A1A</Color>
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}"/>

    <Color x:Key="SuccessColor">#16A34A</Color>
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}"/>

    <!-- ===== حاويات لونية إضافية (Material containers) ===== -->
    <Color x:Key="SecondaryContainerColor">#6366F1</Color>
    <SolidColorBrush x:Key="SecondaryContainerBrush" Color="{StaticResource SecondaryContainerColor}"/>
    <Color x:Key="OnSecondaryContainerColor">#FFFFFF</Color>
    <SolidColorBrush x:Key="OnSecondaryContainerBrush" Color="{StaticResource OnSecondaryContainerColor}"/>

    <Color x:Key="TertiaryContainerColor">#F59E0B</Color>
    <SolidColorBrush x:Key="TertiaryContainerBrush" Color="{StaticResource TertiaryContainerColor}"/>

    <Color x:Key="SurfaceVariantColor">#EEF1F8</Color>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>

    <Color x:Key="SurfaceContainerLowestColor">#F4F6FB</Color>
    <SolidColorBrush x:Key="SurfaceContainerLowestBrush" Color="{StaticResource SurfaceContainerLowestColor}"/>

    <!-- ===== لوحة ألوان "الزجاج" (Apple/macOS Glass) — لشاشات لوحة التحكم/المخزون/العملاء الجديدة فقط ===== -->
    <Color x:Key="GlassBgColor">#FCF8FB</Color>
    <SolidColorBrush x:Key="GlassBgBrush" Color="{StaticResource GlassBgColor}"/>

    <!-- بطاقة "زجاجية" شبه شفافة (تُحاكي تأثير الضبابية الخلفية غير المتاح مباشرة في WPF) -->
    <Color x:Key="GlassCardColor">#F0FFFFFF</Color>
    <SolidColorBrush x:Key="GlassCardBrush" Color="{StaticResource GlassCardColor}"/>

    <Color x:Key="GlassPrimaryColor">#0071E3</Color>
    <SolidColorBrush x:Key="GlassPrimaryBrush" Color="{StaticResource GlassPrimaryColor}"/>

    <Color x:Key="GlassPrimaryDeepColor">#0059B5</Color>
    <SolidColorBrush x:Key="GlassPrimaryDeepBrush" Color="{StaticResource GlassPrimaryDeepColor}"/>

    <Color x:Key="GlassPrimaryTintColor">#D7E2FF</Color>
    <SolidColorBrush x:Key="GlassPrimaryTintBrush" Color="{StaticResource GlassPrimaryTintColor}"/>

    <Color x:Key="GlassTertiaryTintColor">#E3FBE8</Color>
    <SolidColorBrush x:Key="GlassTertiaryTintBrush" Color="{StaticResource GlassTertiaryTintColor}"/>

    <Color x:Key="GlassErrorTintColor">#FFDAD6</Color>
    <SolidColorBrush x:Key="GlassErrorTintBrush" Color="{StaticResource GlassErrorTintColor}"/>

    <Color x:Key="GlassSurfaceContainerColor">#F0EDEF</Color>
    <SolidColorBrush x:Key="GlassSurfaceContainerBrush" Color="{StaticResource GlassSurfaceContainerColor}"/>

    <Color x:Key="GlassSurfaceContainerHighColor">#EAE7EA</Color>
    <SolidColorBrush x:Key="GlassSurfaceContainerHighBrush" Color="{StaticResource GlassSurfaceContainerHighColor}"/>

    <Color x:Key="GlassOutlineColor">#717785</Color>
    <SolidColorBrush x:Key="GlassOutlineBrush" Color="{StaticResource GlassOutlineColor}"/>

    <DropShadowEffect x:Key="GlassCardShadow" BlurRadius="30" ShadowDepth="4"
                      Direction="270" Opacity="0.06" Color="#000000"/>

    <!-- ===== ألوان حالات الصيانة ===== -->
    <Color x:Key="StatusReceivedColor">#3525CD</Color>
    <SolidColorBrush x:Key="StatusReceivedBrush" Color="{StaticResource StatusReceivedColor}"/>

    <Color x:Key="StatusInProgressColor">#F59E0B</Color>
    <SolidColorBrush x:Key="StatusInProgressBrush" Color="{StaticResource StatusInProgressColor}"/>

    <Color x:Key="StatusCompletedColor">#16A34A</Color>
    <SolidColorBrush x:Key="StatusCompletedBrush" Color="{StaticResource StatusCompletedColor}"/>

    <Color x:Key="StatusDeliveredColor">#777587</Color>
    <SolidColorBrush x:Key="StatusDeliveredBrush" Color="{StaticResource StatusDeliveredColor}"/>

    <Color x:Key="RowHoverColor">#EEF2FF</Color>
    <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}"/>

    <Color x:Key="RowPressedColor">#E0E7FF</Color>
    <SolidColorBrush x:Key="RowPressedBrush" Color="{StaticResource RowPressedColor}"/>

    <!-- ألوان الشارات الفاتحة خلف كل حالة -->
    <Color x:Key="StatusReceivedTintColor">#E8E7FD</Color>
    <SolidColorBrush x:Key="StatusReceivedTintBrush" Color="{StaticResource StatusReceivedTintColor}"/>
    <Color x:Key="StatusInProgressTintColor">#FEF3E0</Color>
    <SolidColorBrush x:Key="StatusInProgressTintBrush" Color="{StaticResource StatusInProgressTintColor}"/>
    <Color x:Key="StatusCompletedTintColor">#E6F8EC</Color>
    <SolidColorBrush x:Key="StatusCompletedTintBrush" Color="{StaticResource StatusCompletedTintColor}"/>
    <Color x:Key="StatusDeliveredTintColor">#EDEDF2</Color>
    <SolidColorBrush x:Key="StatusDeliveredTintBrush" Color="{StaticResource StatusDeliveredTintColor}"/>

    <!-- ===== الخط ===== -->
    <FontFamily x:Key="AppFont">Plus Jakarta Sans, Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===== ظل بطاقات ===== -->
    <DropShadowEffect x:Key="CardShadow" BlurRadius="24" ShadowDepth="2"
                      Direction="270" Opacity="0.10" Color="#0B1C30"/>

    <!-- ===== تلميحات (ToolTip) موحّدة ومريحة للعين ===== -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#F7F8FC"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="HasDropShadow" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource OutlineVariantBrush}"
                            BorderThickness="1" CornerRadius="8"
                            Padding="{TemplateBinding Padding}"
                            Effect="{StaticResource CardShadow}"
                            MaxWidth="320">
                        <ContentPresenter TextBlock.LineHeight="18"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== زر عادي (عصري) ===== -->
    <Style x:Key="ModernButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="#E5E9F2"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== صف قائمة بأسلوب: زر واحد قابل للنقر ===== -->
    <Style x:Key="AppleListRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="20,16"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="10" Margin="6,2"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource RowPressedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== شارة حالة ===== -->
    <Style x:Key="StatusPill" TargetType="Border">
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Padding" Value="12,5"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>

    <!-- ===== زر أساسي (Indigo) ===== -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ===== زر خطر ===== -->
    <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource ModernButton}">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
    </Style>

    <!-- ===== زر أيقونة (للإطار) ===== -->
    <!-- ===== أيقونة نصية متمركزة بدقة (يعالج مشكلة عدم التمركز الرأسي المعروفة في خطوط الأيقونات) ===== -->
    <Style x:Key="CenteredGlyphIcon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="LineHeight">
            <Setter.Value>
                <Binding RelativeSource="{RelativeSource Self}" Path="FontSize"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Width" Value="36"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#E5E9F2"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#D0D5E2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== حقل نص ===== -->
    <Style x:Key="ModernTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="Height" Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== حقل كلمة مرور ===== -->
    <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== عنصر قائمة جانبية (على خلفية داكنة) ===== -->
    <Style x:Key="SideNavItem" TargetType="ListBoxItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="10"
                            Margin="0,2" Padding="14,11"
                            Background="Transparent"
                            BorderThickness="0,0,4,0" BorderBrush="Transparent">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="Icon" Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="18"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="Title" Text="{Binding Title}"
                                       Margin="14,0,0,0"
                                       FontFamily="{StaticResource AppFont}"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavHoverBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                            <Setter TargetName="Icon" Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                            <Setter TargetName="Title" Property="Foreground" Value="{StaticResource SidebarTextActiveBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Focusable" Value="True"/>
    </Style>

    <!-- ===== بطاقة موحّدة (تُستخدم في كل الشاشات؛ Card = GlassCard لضمان تناسق كامل) ===== -->
    <Style x:Key="GlassCard" TargetType="Border">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="16"/>
        <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
    </Style>

    <Style x:Key="Card" TargetType="Border" BasedOn="{StaticResource GlassCard}"/>

    <!-- ===== بطاقة "زجاجية" لتصميم Apple/macOS الجديد (لوحة التحكم/المخزون/العملاء) ===== -->
    <Style x:Key="AppleGlassCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource GlassCardBrush}"/>
        <Setter Property="CornerRadius" Value="20"/>
        <Setter Property="Effect" Value="{StaticResource GlassCardShadow}"/>
    </Style>

    <!-- ===== زر تحكم مجزّأ (Segmented Control) بطراز macOS ===== -->
    <Style x:Key="AppleSegmentToggle" TargetType="ToggleButton">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14,0"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardBrush}"/>
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== زر أساسي بطراز Apple (أزرق مستدير) ===== -->
    <Style x:Key="ApplePrimaryButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Background" Value="{StaticResource GlassPrimaryBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="18,0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassPrimaryDeepBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== زر ثانوي بطراز Apple (خلفية فاتحة) ===== -->
    <Style x:Key="AppleGhostButton" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="14,0"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08" Color="#000000"/>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource GlassSurfaceContainerHighBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== عنوان صفحة ===== -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== عنوان قسم ===== -->
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <!-- ===== حقل تحرير داخل خلايا الجداول ===== -->
    <Style x:Key="GridCellTextBox" TargetType="TextBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="8,0"/>
        <Setter Property="Margin" Value="4,2"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Style.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="White"/>
                <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== حقل تاريخ عصرية ===== -->
    <Style x:Key="ModernDatePicker" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Height" Value="40"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DatePicker">
                    <Grid x:Name="PART_Root">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="0"
                                                   Focusable="True" VerticalContentAlignment="Center"
                                                   Padding="12,4" Background="Transparent"
                                                   BorderThickness="0"
                                                   Foreground="{TemplateBinding Foreground}"/>
                                <Button x:Name="PART_Button" Grid.Column="1"
                                        Focusable="False" Width="34"
                                        Background="Transparent" BorderThickness="0">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="Transparent">
                                                <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets"
                                                           FontSize="14" Foreground="{StaticResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Border>

                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="White" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="10" Margin="0,4,0,0"
                                    Effect="{StaticResource CardShadow}">
                                <Calendar x:Name="PART_Calendar"/>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== قائمة منسدلة عصرية ===== -->
    <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13.5"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Padding" Value="12,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" Margin="2,1">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavSelectedBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ModernComboBox" TargetType="ComboBox">
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource OutlineVariantBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="MinHeight" Value="38"/>
        <Setter Property="Padding" Value="12,4"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ModernComboBoxItem}"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                      ClickMode="Press" Focusable="False"
                                      Background="Transparent" BorderThickness="0">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" Background="Transparent"/>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                IsHitTestVisible="False"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="ContentSite"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="9" Foreground="{StaticResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Popup x:Name="Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                               Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" PopupAnimation="Slide">
                            <Border Background="White" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="10"
                                    Margin="0,4,0,0" MaxHeight="320"
                                    Effect="{StaticResource CardShadow}">
                                <ScrollViewer Margin="4" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== خلية جدول ===== -->
    <Style TargetType="DataGridCell">
        <Setter Property="Padding" Value="10,0"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== صف جدول ===== -->
    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Style.Triggers>
            <Trigger Property="AlternationIndex" Value="1">
                <Setter Property="Background" Value="#F4F7FE"/>
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#EEF2FF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{StaticResource NavSelectedBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AppleListRowBorder" TargetType="Border">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="CornerRadius" Value="10"/>
        <Setter Property="Margin" Value="6,2"/>
        <Setter Property="Padding" Value="20,16"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource RowHoverBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Glass Checkbox ===== -->
    <LinearGradientBrush x:Key="GlassCheckGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C8F060" Offset="0"/>
        <GradientStop Color="#60F0B8" Offset="1"/>
    </LinearGradientBrush>

    <Style TargetType="CheckBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource AppFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Grid x:Name="BoxHost" Grid.Column="0" Width="24" Height="24"
                              Margin="0,0,10,0" VerticalAlignment="Center"
                              RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform/>
                            </Grid.RenderTransform>

                            <!-- توهج التفعيل -->
                            <Border x:Name="CheckGlow" CornerRadius="8" Margin="-2"
                                    Background="#4060F0B8" Opacity="0" IsHitTestVisible="False"/>

                            <!-- صندوق المربع -->
                            <Border x:Name="CheckBorder" CornerRadius="7"
                                    Background="#0A000000"
                                    BorderBrush="#1E000000"
                                    BorderThickness="1.5">
                                <Grid>
                                    <!-- خلفية التفعيل -->
                                    <Border x:Name="CheckFill" CornerRadius="5"
                                            Background="{StaticResource GlassCheckGradient}"
                                            Opacity="0" RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                                        </Border.RenderTransform>
                                    </Border>

                                    <!-- علامة الصح -->
                                    <Path x:Name="CheckMark" Data="M5 13l4 4L19 7"
                                          Stroke="#0B1C30" StrokeThickness="2.5"
                                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="13" Height="13"
                                          VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Stretch="Uniform" Opacity="0"
                                          RenderTransformOrigin="0.5,0.5">
                                        <Path.RenderTransform>
                                            <ScaleTransform ScaleX="0" ScaleY="0"/>
                                        </Path.RenderTransform>
                                    </Path>
                                </Grid>
                            </Border>
                        </Grid>

                        <!-- التسمية -->
                        <ContentPresenter Grid.Column="1"
                                          VerticalAlignment="Center"
                                          RecognizesAccessKey="True"
                                          Margin="0"/>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- عند المرور -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#503525CD"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>

                        <!-- عند التفعيل -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="CheckFill" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckMark" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckGlow" Property="Opacity" Value="1"/>
                            <Setter TargetName="CheckBorder" Property="Background" Value="Transparent"/>
                            <Setter TargetName="CheckBorder" Property="BorderBrush" Value="Transparent"/>
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckFill"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.25"
                                                         EasingFunction="{StaticResource BounceEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckFill"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.25"
                                                         EasingFunction="{StaticResource BounceEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.25"
                                                         BeginTime="0:0:0.08"
                                                         EasingFunction="{StaticResource BounceEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.25"
                                                         BeginTime="0:0:0.08"
                                                         EasingFunction="{StaticResource BounceEase}"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxHost"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1.05" Duration="0:0:0.15"
                                                         AutoReverse="True"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxHost"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1.05" Duration="0:0:0.15"
                                                         AutoReverse="True"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CheckFill"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckFill"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="CheckMark"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="0" Duration="0:0:0.12"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxHost"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                         To="1" Duration="0:0:0.15"/>
                                        <DoubleAnimation Storyboard.TargetName="BoxHost"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                         To="1" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
